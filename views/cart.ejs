<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Cart</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #eb950c;
            --primary-hover: #f4a91d;
            --secondary-color: black;
            --accent-color: #f8f9fa;
            --text-dark: #2c2c2c;
            --text-light: #6c757d;
            --border-color: #e9ecef;
            --shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
            --gold-gradient: linear-gradient(135deg, #eb950c 0%, #f4a91d 50%, #ffcc66 100%);
            --dark-gradient: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #2a2a2a 100%);
            --glass-bg: rgba(255, 255, 255, 0.05);
            --glass-border: rgba(255, 255, 255, 0.1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: var(--dark-gradient);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* Animated background elements */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                radial-gradient(circle at 20% 80%, rgba(235, 149, 12, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(244, 169, 29, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 40% 40%, rgba(255, 204, 102, 0.05) 0%, transparent 50%);
            z-index: -1;
            animation: backgroundShift 20s ease-in-out infinite;
        }

        @keyframes backgroundShift {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            33% { transform: translate(-10px, -20px) rotate(1deg); }
            66% { transform: translate(10px, 10px) rotate(-1deg); }
        }

        .cart-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
            position: relative;
            z-index: 1;
        }

        .cart-title {
            font-size: clamp(2.5rem, 5vw, 4rem);
            font-weight: 800;
            background: var(--gold-gradient);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 30px rgba(235, 149, 12, 0.3);
            margin-bottom: 3rem;
            letter-spacing: -0.02em;
            animation: titleGlow 3s ease-in-out infinite alternate;
            text-align: center;
        }

        @keyframes titleGlow {
            from { text-shadow: 0 0 20px rgba(235, 149, 12, 0.3); }
            to { text-shadow: 0 0 40px rgba(235, 149, 12, 0.6); }
        }

        /* Empty Cart Styling */
        .empty-cart {
            text-align: center;
            padding: 4rem 2rem;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 24px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            animation: fadeInUp 0.8s ease-out;
        }

        .empty-cart::before {
            content: '🛒';
            font-size: 4rem;
            display: block;
            margin-bottom: 2rem;
            animation: bounce 2s infinite;
        }

        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
            40% { transform: translateY(-10px); }
            60% { transform: translateY(-5px); }
        }

        .empty-cart h2 {
            color: #ffffff;
            font-size: 2rem;
            margin-bottom: 1rem;
            font-weight: 600;
        }

        .empty-cart p {
            color: rgba(255, 255, 255, 0.7);
            font-size: 1.1rem;
            margin-bottom: 2rem;
            line-height: 1.6;
        }

        .btn-shop {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--gold-gradient);
            color: #000;
            padding: 1rem 2rem;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 10px 30px rgba(235, 149, 12, 0.3);
            position: relative;
            overflow: hidden;
        }

        .btn-shop::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        .btn-shop:hover::before {
            left: 100%;
        }

        .btn-shop:hover {
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 15px 40px rgba(235, 149, 12, 0.4);
        }

        /* Table Wrapper */
        .table-wrapper {
            background: rgba(255, 255, 255, 0.03);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            animation: fadeInUp 0.8s ease-out 0.2s both;
        }

        .cart-table {
            width: 100%;
            border-collapse: collapse;
        }

        .cart-table thead {
            background: rgba(0, 0, 0, 0.2);
        }

        .cart-table th {
            padding: 1.5rem;
            color: var(--primary-color);
            font-weight: 700;
            font-size: 1.1rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid var(--primary-color);
        }

        .cart-table td {
            padding: 2rem 1.5rem;
            color: #ffffff;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            vertical-align: middle;
        }

        .cart-table tr {
            transition: all 0.3s ease;
        }

        .cart-table tbody tr:hover {
            background: rgba(255, 255, 255, 0.02);
            transform: translateX(5px);
        }

        .cart-table tbody tr:last-child {
            border-bottom: none;
        }

        /* Item Name Styling */
        .cart-table td:first-child {
            font-weight: 600;
            font-size: 1.1rem;
        }

        /* Price Styling */
        .cart-table td:nth-child(2) {
            color: var(--primary-color);
            font-weight: 700;
            font-size: 1.2rem;
        }

        /* Quantity Controls */
        .cart-table td:nth-child(3) {
            text-align: center;
        }

        .decrement, .increment {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: none;
            background: var(--gold-gradient);
            color: #000;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin: 0 0.5rem;
        }

        .decrement:hover, .increment:hover {
            transform: scale(1.1);
            box-shadow: 0 5px 15px rgba(235, 149, 12, 0.4);
        }

        .cart-table td:nth-child(3) span {
            color: #ffffff;
            font-weight: 600;
            font-size: 1.1rem;
            min-width: 30px;
            display: inline-block;
            text-align: center;
        }

        /* Total Price Styling */
        .cart-table td:nth-child(4) {
            color: #ffffff;
            font-weight: 700;
            font-size: 1.3rem;
        }

        /* Remove Button */
        .remove {
            background: rgba(255, 59, 48, 0.1);
            border: 1px solid rgba(255, 59, 48, 0.3);
            color: #ff3b30;
            padding: 0.5rem 1rem;
            border-radius: 25px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .remove:hover {
            background: rgba(255, 59, 48, 0.2);
            transform: scale(1.05);
        }

        /* Cart Summary Row */
        .cart-summary {
            background: rgba(0, 0, 0, 0.3) !important;
            border-top: 2px solid var(--primary-color) !important;
        }

        .cart-summary td {
            padding: 2rem 1.5rem !important;
            font-size: 1.3rem !important;
            font-weight: 700 !important;
        }

        .cart-summary td:nth-child(4) {
            color: var(--primary-color) !important;
            font-size: 2rem !important;
        }

        .btn-order {
            background: var(--gold-gradient);
            color: #000;
            border: none;
            padding: 1rem 2.5rem;
            border-radius: 50px;
            font-size: 1.2rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 10px 30px rgba(235, 149, 12, 0.3);
            position: relative;
            overflow: hidden;
        }

        .btn-order::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        .btn-order:hover::before {
            left: 100%;
        }

        .btn-order:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 15px 40px rgba(235, 149, 12, 0.5);
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .cart-container {
                padding: 1rem;
            }

            .cart-table {
                font-size: 0.9rem;
            }

            .cart-table th,
            .cart-table td {
                padding: 1rem 0.5rem;
            }

            .cart-title {
                font-size: 2rem;
            }
        }

        /* Floating particles effect */
        .particle {
            position: absolute;
            width: 4px;
            height: 4px;
            background: var(--primary-color);
            border-radius: 50%;
            opacity: 0.3;
            animation: float 6s infinite linear;
        }

        @keyframes float {
            0% {
                transform: translateY(100vh) rotate(0deg);
                opacity: 0;
            }
            10% {
                opacity: 0.3;
            }
            90% {
                opacity: 0.3;
            }
            100% {
                transform: translateY(-100vh) rotate(360deg);
                opacity: 0;
            }
        }
    </style>
</head>

<body>
    <!-- Floating particles -->
    <div id="particles"></div>

    <div class="cart-container">
        <h1 class="cart-title">Your Cart</h1>

        <% if (!cart || !cart.products || cart.products.length===0) { %>
            <!-- Empty Cart Layout -->
            <div class="empty-cart">
                <h2>Your cart is empty!</h2>
                <p>Looks like you haven't added anything to your cart yet.</p>
                <a href="http://localhost:3000/home/burger" class="btn-shop">
                    <i class="fas fa-utensils"></i>
                    Continue Shopping
                </a>
            </div>
        <% } else { %>
            <!-- Cart Items Layout -->
            <div class="table-wrapper">
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% let totalPrice=0; %>
                        <% cart.products.forEach(item=> { %>
                            <% const itemTotalPrice=item.quantity * item.price; %>
                            <% totalPrice +=itemTotalPrice; %>
                            <tr>
                                <td>
                                    <%= item.name %>
                                </td>
                                <td>$<%= item.price.toFixed(2) %>
                                </td>
                                <td>
                                    <button class="decrement" data-name="<%= item.name %>">−</button>
                                    <span>
                                        <%= item.quantity %>
                                    </span>
                                    <button class="increment" data-name="<%= item.name %>">+</button>
                                </td>
                                <td>$<%= itemTotalPrice.toFixed(2) %>
                                </td>
                                <td>
                                    <button class="remove" data-name="<%= item.name %>">
                                        <i class="fas fa-trash"></i> Remove
                                    </button>
                                </td>
                            </tr>
                        <% }); %>
                        <tr class="cart-summary">
                            <td colspan="3"><strong>Total Price:</strong></td>
                            <td><strong>$<%= totalPrice.toFixed(2) %></strong></td>
                            <td><button id="order" class="btn-order">
                                <i class="fas fa-credit-card"></i>
                                Place Order
                            </button></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="../js/cart.js"></script> <!-- Your original JavaScript file -->

    <script>
        // Create floating particles effect
        function createParticles() {
            const particlesContainer = document.getElementById('particles');
            
            setInterval(() => {
                const particle = document.createElement('div');
                particle.className = 'particle';
                particle.style.left = Math.random() * 100 + '%';
                particle.style.animationDelay = Math.random() * 2 + 's';
                particle.style.animationDuration = (Math.random() * 4 + 4) + 's';
                particlesContainer.appendChild(particle);

                // Remove particle after animation
                setTimeout(() => {
                    particle.remove();
                }, 8000);
            }, 2000);
        }

        // Add enhanced visual feedback for quantity changes
        function enhanceQuantityButtons() {
            document.querySelectorAll('.increment, .decrement').forEach(btn => {
                btn.addEventListener('click', function() {
                    const quantitySpan = this.parentElement.querySelector('span');
                    
                    // Add bounce animation to quantity display
                    quantitySpan.style.transform = 'scale(1.2)';
                    quantitySpan.style.transition = 'transform 0.15s ease';
                    
                    setTimeout(() => {
                        quantitySpan.style.transform = 'scale(1)';
                    }, 150);
                });
            });
        }

        // Add enhanced visual feedback for remove buttons
        function enhanceRemoveButtons() {
            document.querySelectorAll('.remove').forEach(btn => {
                btn.addEventListener('click', function() {
                    const row = this.closest('tr');
                    
                    // Add slide-out animation
                    row.style.transform = 'translateX(-100%)';
                    row.style.opacity = '0';
                    row.style.transition = 'all 0.3s ease';
                });
            });
        }

        // Add enhanced order button feedback
        function enhanceOrderButton() {
            const orderBtn = document.getElementById('order');
            if (orderBtn) {
                orderBtn.addEventListener('click', function() {
                    // Add success visual feedback
                    this.innerHTML = '<i class="fas fa-check"></i> Order Placed!';
                    this.style.background = 'linear-gradient(135deg, #28a745, #20c997)';
                });
            }
        }

        // Initialize enhancements
        document.addEventListener('DOMContentLoaded', function() {
            createParticles();
            enhanceQuantityButtons();
            enhanceRemoveButtons();
            enhanceOrderButton();
            
            // Add stagger animation to table rows
            document.querySelectorAll('.cart-table tbody tr').forEach((row, index) => {
                row.style.animationDelay = (index * 0.1) + 's';
                row.style.animation = 'fadeInUp 0.6s ease-out both';
            });
        });
    </script>
</body>

</html>