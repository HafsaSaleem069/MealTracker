<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <style>
        :root {
            --primary-color: #eb950c;
            --primary-hover: #f4a91d;
            --secondary-color: black;
            --accent-color: #f8f9fa;
            --text-dark: #2c2c2c;
            --text-light: #6c757d;
            --border-color: #e9ecef;
            --shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
            --gold-gradient: linear-gradient(135deg, #eb950c 0%, #f4a91d 50%, #ffcc66 100%);
            --dark-gradient: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #2a2a2a 100%);
            --glass-bg: rgba(255, 255, 255, 0.05);
            --glass-border: rgba(255, 255, 255, 0.1);
        }

        #password-checklist-container {
            margin-top: 15px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 15px;
            backdrop-filter: blur(10px);
        }

        .progress-bar {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 25px;
            overflow: hidden;
            height: 8px;
            margin-bottom: 15px;
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.3);
        }

        #progress-fill {
            background: var(--gold-gradient);
            width: 0%;
            height: 100%;
            transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 0 10px rgba(235, 149, 12, 0.5);
        }

        .checklist {
            list-style: none;
            padding-left: 0;
            margin: 0;
        }

        .checklist li {
            font-size: 13px;
            color: #ff6b6b;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            padding: 8px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            align-items: center;
            font-weight: 500;
        }

        .checklist li:last-child {
            border-bottom: none;
        }

        .checklist li.valid {
            color: #51cf66;
            transform: translateX(5px);
        }

        .checklist li::before {
            margin-right: 8px;
            font-size: 12px;
        }

        body {
            background: var(--dark-gradient);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            position: relative;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background:
                radial-gradient(circle at 20% 50%, rgba(0, 0, 0, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(244, 169, 29, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 40% 80%, rgba(0, 0, 0, 0.687) 0%, transparent 50%);
            z-index: -1;
        }

        .innerBody {
            position: relative;
            backdrop-filter: blur(20px);
            background: linear-gradient(135deg,
                    rgba(255, 255, 255, 0.1) 0%,
                    rgba(255, 255, 255, 0.05) 50%,
                    rgba(0, 0, 0, 0.1) 100%);
            border: 1px solid var(--glass-border);
            border-radius: 30px;
            padding: 40px;
            width: 90%;
            max-width: 600px;
            box-shadow:
                var(--shadow),
                0 0 40px rgba(235, 149, 12, 0.1),
                inset 0 1px 0 rgba(255, 255, 255, 0.1);
            animation: slideInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        h2 {
            background: var(--gold-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 1.5rem;
            text-align: center;
            font-weight: 700;
            font-size: 2.2rem;
            letter-spacing: -0.5px;
            text-shadow: 0 2px 10px rgba(235, 149, 12, 0.3);
        }

        .form-label {
            color: var(--accent-color);
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 8px;
            letter-spacing: 0.3px;
        }

        input[type="text"],
        input[type="email"],
        input[type="password"] {
            background: rgba(0, 0, 0, 0.4);
            color: #ffffff !important;
            border: 1px solid rgba(235, 149, 12, 0.3);
            border-radius: 12px;
            padding: 14px 16px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            font-size: 15px;
            backdrop-filter: blur(10px);
        }

        input[type="text"]::placeholder,
        input[type="email"]::placeholder,
        input[type="password"]::placeholder {
            color: rgba(248, 249, 250, 0.5);
            font-size: 14px;
        }

        input[type="text"]:focus,
        input[type="email"]:focus,
        input[type="password"]:focus {
            outline: none;
            border: 2px solid var(--primary-color);
            box-shadow:
                0 0 20px rgba(235, 149, 12, 0.4),
                inset 0 1px 0 rgba(255, 255, 255, 0.1);
            transform: translateY(-2px);
            background: rgba(0, 0, 0, 0.6);
        }

        input::placeholder {
            color: rgba(255, 255, 255, 0.5) !important;
            /* 👈 Light white placeholder */
        }

        #RegisterButton {
            background: var(--gold-gradient);
            color: var(--secondary-color);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: none;
            border-radius: 15px;
            padding: 16px 24px;
            font-weight: 700;
            font-size: 16px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            position: relative;
            overflow: hidden;
            box-shadow:
                0 8px 25px rgba(235, 149, 12, 0.3),
                inset 0 1px 0 rgba(255, 255, 255, 0.2);
        }

        #RegisterButton::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        #RegisterButton:hover {
            transform: translateY(-3px);
            box-shadow:
                0 12px 35px rgba(235, 149, 12, 0.4),
                inset 0 1px 0 rgba(255, 255, 255, 0.3);
        }

        #RegisterButton:hover::before {
            left: 100%;
        }

        #RegisterButton:active {
            transform: translateY(-1px);
        }

        .BrandDescription p {
            color: rgba(248, 249, 250, 0.8);
            text-align: center;
            font-size: 16px;
            font-weight: 400;
            margin-bottom: 2rem;
            line-height: 1.6;
        }

        .field {
            margin-bottom: 1.5rem;
            position: relative;
        }

        .field:focus-within .form-label {
            color: var(--primary-color);
            transform: scale(0.95);
        }

        /* Enhanced mobile responsiveness */
        @media (max-width: 768px) {
            .innerBody {
                padding: 30px 25px;
                margin: 20px;
                border-radius: 25px;
            }

            h2 {
                font-size: 1.8rem;
            }

            input[type="text"],
            input[type="email"],
            input[type="password"] {
                padding: 12px 14px;
                font-size: 14px;
            }

            #RegisterButton {
                padding: 14px 20px;
                font-size: 15px;
            }

            #password-checklist-container {
                padding: 15px;
            }
        }

        /* Subtle animations for form elements */
        .field {
            animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
            opacity: 0;
        }

        .field:nth-child(1) {
            animation-delay: 0.1s;
        }

        .field:nth-child(2) {
            animation-delay: 0.15s;
        }

        .field:nth-child(3) {
            animation-delay: 0.2s;
        }

        .field:nth-child(4) {
            animation-delay: 0.25s;
        }

        .field:nth-child(5) {
            animation-delay: 0.3s;
        }

        @keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }

            from {
                opacity: 0;
                transform: translateY(20px);
            }
        }
    </style>
</head>

<body>
    <div class="innerBody">
        <div class="mx-3 BrandDescription row" id="RegisterSection">
            <!-- Form Section Left -->
            <div class="col-lg-12 pt-2">
                <h2 class="mb-4 w-100">Create Your Account</h2>
                <p class="mb-1 mx-3">Register now and enjoy the best food experience!</p>

                <form>
                    <div class="mb-3 field">
                        <label for="fullname" class="form-label">Full Name</label>
                        <input type="text" id="fullname" placeholder="Enter your full name" class="form-control">
                    </div>
                    <div class="mb-3 field">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" id="email" placeholder="Enter your email" class="form-control">
                    </div>

                    <div class="mb-3 field">
                        <label for="password" class="form-label">Password</label>
                        <input type="password" id="password" placeholder="Enter your password" class="form-control">
                    </div>

                    <div class="mb-3 field">
                        <label for="phone" class="form-label">Phone Number</label>
                        <input type="text" id="phone" placeholder="Enter your phone number" class="form-control">
                    </div>
                    <div class="mb-3 field">
                        <label for="address" class="form-label">Address</label>
                        <input type="text" id="address" placeholder="Enter your address" class="form-control">
                    </div>
                    <div id="password-checklist-container">
                        <div class="progress-bar">
                            <div id="progress-fill"></div>
                        </div>
                        <ul class="checklist">
                            <li id="length">❌ At least 8 characters</li>
                            <li id="uppercase">❌ One uppercase letter</li>
                            <li id="lowercase">❌ One lowercase letter</li>
                            <li id="number">❌ One number</li>
                            <li id="special">❌ One special character (@$!%*?&)</li>
                        </ul>
                    </div>

                    <button id="RegisterButton" type="submit" class="btn-lg w-100 mt-3">Register</button>

                </form>

            </div>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/js/register.js"></script>
</body>

</html>