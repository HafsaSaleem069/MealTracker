<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <style>
        :root {
            --primary-color: #eb950c;
            --primary-hover: #f4a91d;
            --secondary-color: black;
            --accent-color: #f8f9fa;
            --text-dark: #2c2c2c;
            --text-light: #6c757d;
            --border-color: #e9ecef;
            --shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
            --gold-gradient: linear-gradient(135deg, #eb950c 0%, #f4a91d 50%, #ffcc66 100%);
            --dark-gradient: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #2a2a2a 100%);
            --glass-bg: rgba(255, 255, 255, 0.05);
            --glass-border: rgba(255, 255, 255, 0.1);
        }

        body {
            background: var(--dark-gradient);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            position: relative;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background:
                radial-gradient(circle at 20% 50%, rgba(6, 5, 5, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(244, 169, 29, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 40% 80%, rgba(198, 157, 91, 0.05) 0%, transparent 50%);
            z-index: -1;
        }

        .innerBody {
            position: relative;
            backdrop-filter: blur(20px);
            background: linear-gradient(135deg,
                    rgba(255, 255, 255, 0.1) 0%,
                    rgba(255, 255, 255, 0.05) 50%,
                    rgba(0, 0, 0, 0.1) 100%);
            border: 1px solid var(--glass-border);
            border-radius: 30px;
            padding: 40px;
            width: 90%;
            max-width: 600px;
            min-height: 550px;
            box-shadow:
                var(--shadow),
                0 0 40px rgba(235, 149, 12, 0.1),
                inset 0 1px 0 rgba(255, 255, 255, 0.1);
            animation: slideInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        h2 {
            background: var(--gold-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 1.5rem;
            text-align: center;
            font-weight: 700;
            font-size: 2.4rem;
            letter-spacing: -0.5px;
            text-shadow: 0 2px 10px rgba(235, 149, 12, 0.3);
        }

        .form-label {
            color: var(--accent-color);
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 8px;
            letter-spacing: 0.3px;
        }

        input[type="text"],
        input[type="email"],
        input[type="password"] {
            background: rgba(0, 0, 0, 0.4);
            color: #ffffff !important;
            border: 1px solid rgba(235, 149, 12, 0.3);
            border-radius: 12px;
            padding: 16px 18px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            font-size: 15px;
            backdrop-filter: blur(10px);
        }

        input[type="text"]::placeholder,
        input[type="email"]::placeholder,
        input[type="password"]::placeholder {
            color: rgba(248, 249, 250, 0.5);
            font-size: 14px;
        }

        input[type="text"]:focus,
        input[type="email"]:focus,
        input[type="password"]:focus {
            outline: none;
            border: 2px solid var(--primary-color);
            box-shadow:
                0 0 20px rgba(235, 149, 12, 0.4),
                inset 0 1px 0 rgba(255, 255, 255, 0.1);
            transform: translateY(-2px);
            background: rgba(0, 0, 0, 0.6);
        }

        #LoginButton {
            background: var(--gold-gradient);
            color: var(--secondary-color);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: none;
            border-radius: 15px;
            padding: 16px 24px;
            font-weight: 700;
            font-size: 16px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            position: relative;
            overflow: hidden;
            box-shadow:
                0 8px 25px rgba(235, 149, 12, 0.3),
                inset 0 1px 0 rgba(255, 255, 255, 0.2);
        }

        #LoginButton::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        #LoginButton:hover {
            transform: translateY(-3px);
            box-shadow:
                0 12px 35px rgba(235, 149, 12, 0.4),
                inset 0 1px 0 rgba(255, 255, 255, 0.3);
        }

        #LoginButton:hover::before {
            left: 100%;
        }

        #LoginButton:active {
            transform: translateY(-1px);
        }

        .BrandDescription p {
            color: rgba(248, 249, 250, 0.8);
            text-align: center;
            font-size: 16px;
            font-weight: 400;
            margin-bottom: 2.5rem;
            line-height: 1.6;
        }

        /* Register link styling */
        .BrandDescription p:last-of-type {
            margin-top: 25px;
            padding: 15px;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            backdrop-filter: blur(10px);
            font-size: 15px;
        }

        .BrandDescription p a {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            position: relative;
        }

        .BrandDescription p a::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -2px;
            left: 0;
            background: var(--gold-gradient);
            transition: width 0.3s ease;
        }

        .BrandDescription p a:hover {
            color: var(--primary-hover);
            transform: translateY(-1px);
        }

        .BrandDescription p a:hover::after {
            width: 100%;
        }

        /* Forgot password link styling */
        #forgot-password {
            color: rgba(248, 249, 250, 0.7);
            text-decoration: none;
            font-size: 14px;
            display: block;
            text-align: center;
            margin-top: 15px;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        #forgot-password:hover {
            color: var(--primary-color);
            transform: translateY(-1px);
        }

        .field {
            margin-bottom: 1.8rem;
            position: relative;
        }

        .field:focus-within .form-label {
            color: var(--primary-color);
            transform: scale(0.95);
        }

        /* Google Sign-in button styling */
        .g_id_signin {
            margin-top: 25px;
            display: flex;
            justify-content: center;
            filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.3));
        }

        /* Enhanced mobile responsiveness */
        @media (max-width: 768px) {
            .innerBody {
                padding: 30px 25px;
                margin: 20px;
                border-radius: 25px;
                min-height: 500px;
            }

            h2 {
                font-size: 2rem;
            }

            input[type="text"],
            input[type="email"],
            input[type="password"] {
                padding: 14px 16px;
                font-size: 14px;
            }

            #LoginButton {
                padding: 14px 20px;
                font-size: 15px;
            }

            .BrandDescription p {
                font-size: 15px;
                margin-bottom: 2rem;
            }
        }

        /* Subtle animations for form elements */
        .field {
            animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
            opacity: 0;
        }

        .field:nth-child(1) {
            animation-delay: 0.1s;
        }

        .field:nth-child(2) {
            animation-delay: 0.15s;
        }

        @keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }

            from {
                opacity: 0;
                transform: translateY(20px);
            }
        }

        /* Additional elements animation */
        .BrandDescription p:first-of-type {
            animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.05s forwards;
            opacity: 0;
        }

        #LoginButton {
            animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.2s forwards;
            opacity: 0;
        }

        .BrandDescription p:last-of-type {
            animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.25s forwards;
            opacity: 0;
        }

        #forgot-password {
            animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.3s forwards;
            opacity: 0;
        }

        .g_id_signin {
            animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.35s forwards;
            opacity: 0;
        }
    </style>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/js/register.js"></script>

</head>

<body>
    <div class="innerBody">
        <div class="mx-3 BrandDescription row" id="LoginSection">
            <!-- Form Section -->
            <div class="col-lg-12 pt-2">
                <h2 class="mb-4">Welcome Back!</h2>
                <p class="mb-4">Login to your account and enjoy the best food experience!</p>

                <form>
                    <div class="mb-3 field">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" id="email" placeholder="Enter your email" class="form-control">
                    </div>
                    <div class="mb-3 field">
                        <label for="password" class="form-label">Password</label>
                        <input type="password" id="password" placeholder="Enter your password" class="form-control">
                    </div>
                    <button id="LoginButton" type="submit" class="btn-lg w-100 mt-3">Login</button>
                    <p style="margin-top: 20px;padding: 10px;">Not registered yet? <a style="color: #e8a300;"
                            href="http://localhost:3000/home/register">Register</a></p>
                    <a href="/home/reset-password" id="forgot-password">Forgot Password?</a>

                    <!-- Google One Tap Login Button
                    <div id="g_id_onload"
                        data-client_id="832761851712-kubtp813vs6b7iledisqok9mrqdnn31v.apps.googleusercontent.com"
                        data-context="signin" data-ux_mode="popup" data-callback="handleGoogleLogin"
                        data-auto_prompt="false">
                    </div>

                    <div class="g_id_signin" data-type="standard" data-shape="rectangular" data-theme="outline"
                        data-text="sign_in_with" data-size="large" data-logo_alignment="left">
                    </div> -->
                </form>
            </div>
        </div>
    </div>
</body>

</html>